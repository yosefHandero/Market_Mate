# Copy to .env and adjust. Safe defaults: execution and live trading off; read API not public until you opt in.

APP_ENV=development
APP_NAME=Market Mate Scanner API
APP_VERSION=1.0.0
# Optional stable worker identity for heartbeat reporting.
APP_INSTANCE_ID=
DATABASE_URL=sqlite:///./market_mate.db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth: in production set APP_ENV=production and ADMIN_API_TOKEN. For local dev you may set PUBLIC_READ_ACCESS_ENABLED=true
# without tokens; for serious environments keep public read off and set READ_API_TOKEN.
# Mirror READ_API_TOKEN into apps/web SCANNER_READ_API_TOKEN.
# Mirror ADMIN_API_TOKEN into apps/web SCANNER_ADMIN_API_TOKEN.
PUBLIC_READ_ACCESS_ENABLED=true
READ_API_TOKEN=
ADMIN_API_TOKEN=

LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true

HEALTH_MAX_STALE_MINUTES=30
SIGNAL_MAX_AGE_MINUTES=120
STALE_SIGNAL_MAX_AGE_MINUTES=10
STARTUP_CHECK_TIMEOUT_SECONDS=5
REQUIRE_READYZ_FOR_EXECUTION=true
TRUST_RECENT_WINDOW_DAYS=14
WORKER_HEARTBEAT_STALE_SECONDS=90

SCHEDULER_ENABLED=false
SCHEDULER_POLL_SECONDS=15
SCHEDULER_LEASE_SECONDS=120
SCHEDULER_RUN_MISSED_ON_STARTUP=true

# Watchlist: defaults live in config.py; env overrides take precedence.
# SPY and QQQ are required for market-status benchmarking but are excluded from scan rows.
# SEC + options calls run per stock per scan; news calls fire only when price/RS thresholds hit.
# With ~49 stocks + 20 crypto the scan takes roughly 4-5x longer than the original 12+2 list.
# If latency or provider errors increase, trim lists or lower SCAN_CONCURRENCY_LIMIT.
WATCHLIST=AAPL,MSFT,NVDA,AMD,META,AMZN,GOOGL,AVGO,CRM,ORCL,CSCO,INTC,TSLA,NFLX,DIS,JPM,BAC,GS,MS,V,MA,BRK.B,UNH,JNJ,LLY,MRK,ABBV,XOM,CVX,CAT,DE,UPS,WMT,PG,KO,PEP,HD,NKE,MCD,LIN,NEE,T,VZ,AMAT,LRCX,COIN,PLTR,SPY,QQQ
# Crypto pairs must use BASE/USD format matching Alpaca v1beta3 crypto/us endpoint.
# All pairs below are verified against Alpaca's supported USD pairs.
CRYPTO_WATCHLIST=BTC/USD,ETH/USD,SOL/USD,XRP/USD,DOGE/USD,ADA/USD,AVAX/USD,LINK/USD,DOT/USD,LTC/USD,UNI/USD,SHIB/USD,BCH/USD,AAVE/USD,POL/USD,PEPE/USD,FIL/USD,GRT/USD,RENDER/USD,BONK/USD
SCAN_INTERVAL_SECONDS=300
SCAN_CONCURRENCY_LIMIT=8
CACHE_DIR=./var/cache

TRADE_GATE_ENABLED=true
TRADE_GATE_HORIZON=1h
TRADE_GATE_MIN_EVALUATED_COUNT=20
TRADE_GATE_MIN_WIN_RATE=55
TRADE_GATE_MIN_AVG_RETURN=0.15
# Crypto BUY is weaker/underpowered after friction and out-of-sample, so it must
# clear a higher sample bar than stock BUY. Stricter only; never loosens the gate.
TRADE_GATE_CRYPTO_BUY_MIN_EVALUATED_COUNT=30
TRADE_GATE_ALLOWED_SIGNALS=BUY,SELL
TRADE_GATE_MAX_NOTIONAL=1000
TRADE_GATE_MAX_QTY=5

# Signal-generation thresholds (separate stock vs crypto BUY/SELL gates).
# Crypto can run stricter than stock; raise crypto buy threshold/margin to keep
# weak crypto BUY out without touching stock BUY.
SIGNAL_BUY_THRESHOLD=52
SIGNAL_SELL_THRESHOLD=52
SIGNAL_MARGIN=6
SIGNAL_CRYPTO_BUY_THRESHOLD=52
SIGNAL_CRYPTO_SELL_THRESHOLD=52
SIGNAL_CRYPTO_MARGIN=6

PORTFOLIO_RISK_ENABLED=true
PORTFOLIO_MAX_DAILY_NOTIONAL=2500
PORTFOLIO_MAX_SYMBOL_NOTIONAL=1000
PORTFOLIO_MAX_ASSET_TYPE_NOTIONAL=2000
PORTFOLIO_DAILY_LOSS_LIMIT_PCT=-2
PORTFOLIO_MAX_LOSS_STREAK=3
PORTFOLIO_MAX_DRAWDOWN_PCT=5

CALIBRATION_MIN_SIGNAL_SAMPLES=20
CALIBRATION_MIN_SCORE_BAND_SAMPLES=10
OUTCOME_REPORT_MIN_EVALUATED_PER_HORIZON=20
OUTCOME_BASELINE_MIN_EVALUATED_PER_HORIZON=20
OUTCOME_BASELINE_MIN_MEAN_RETURN_PCT=0
OUTCOME_EVALUATION_BATCH_LIMIT=2000
TRACK_HOLD_OUTCOMES=true
VALIDATION_PRIMARY_HORIZON=1h
VALIDATION_WIN_THRESHOLD_PCT=0
VALIDATION_FALSE_POSITIVE_THRESHOLD_PCT=0
VALIDATION_MIN_SAMPLE_SIZE=30
WF_TRAIN_DAYS=30
WF_HOLDOUT_DAYS=7
# Historical walk-forward proof engine (daily-bar weekly-pattern layer).
PROOF_TARGET_YEARS=3
PROOF_MIN_YEARS=2
PROOF_MAX_YEARS=5
PROOF_HOLDOUT_MONTHS=9
PROOF_LOOKBACK_CONTEXT_MONTHS_MIN=6
PROOF_LOOKBACK_CONTEXT_MONTHS_MAX=24
PROOF_PATTERN_MIN_DAYS=20
PROOF_PATTERN_MAX_DAYS=60
PROOF_STEP_DAYS=7
PROOF_TOP_N_PER_ASSET=5
PROOF_MIN_PATTERN_SAMPLES=12
PROOF_DAILY_LOOKBACK_BARS_MAX=1300
PROOF_FETCH_CHUNK_DAYS=3650
PROOF_PILOT_MIN_PREDICTIONS_PER_ASSET=120
PROOF_PILOT_MIN_UPSIDE_HIT_RATE_PCT=55
PROOF_PILOT_MAX_CALIBRATION_GAP_PCT=10
PROOF_PILOT_MIN_AFTER_FRICTION_RETURN_PCT=0
PROOF_PILOT_MAX_DRAWDOWN_PCT=25
PROOF_PILOT_MIN_EXIT_WINDOW_HELPED_RATE_PCT=50
STOCK_SLIPPAGE_BPS=5
STOCK_SPREAD_BPS=2
STOCK_FEE_BPS=0
CRYPTO_SLIPPAGE_BPS=12
CRYPTO_SPREAD_BPS=6
CRYPTO_FEE_BPS=10

ALPACA_API_KEY=
ALPACA_API_SECRET=
# Alpaca is used for MARKET DATA only. There is no trading-API base URL because
# this build has no broker order-submission code.
ALPACA_MARKET_DATA_URL=https://data.alpaca.markets
# Paper-only safety invariants. Setting either value to true is forbidden and
# causes an immediate startup failure (Settings.forbid_live_execution); these
# flags exist only so the process refuses to run, not to enable submission.
EXECUTION_ENABLED=false
ALLOW_LIVE_TRADING=false
EXECUTION_DEFAULT_TIME_IN_FORCE=day

PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
PROVIDER_MAX_BAR_AGE_MINUTES=45
ALPACA_LATEST_DATA_CACHE_SECONDS=5
SEC_COMPANY_TICKERS_CACHE_SECONDS=21600
SEC_FILINGS_CACHE_SECONDS=900
SEC_COMPANY_FACTS_CACHE_SECONDS=3600
COINGECKO_CACHE_SECONDS=120
FEAR_GREED_CACHE_SECONDS=300
OPTIONS_FLOW_CACHE_SECONDS=600

# Fallback stock bar provider when Alpaca market data fails (stocks only).
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
# Paid MarketData.app options chain (off by default; yahooquery/yfinance are free fallbacks).
MARKETDATA_OPTIONS_ENABLED=false
MARKETDATA_API_TOKEN=
MARKETAUX_API_TOKEN=
FINNHUB_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINBASE_WS_ENABLED=true
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_WS_CHANNEL=ticker
COINBASE_WS_PRODUCTS=BTC-USD,ETH-USD
COINBASE_WS_RECONNECT_BASE_SECONDS=1
COINBASE_WS_RECONNECT_MAX_SECONDS=30
COINBASE_WS_SNAPSHOT_STALE_SECONDS=150
COINBASE_WS_LOG_MESSAGES=false
ALT_FNG_API_URL=https://api.alternative.me/fng/?limit=1&format=json
SEC_USER_AGENT=MarketMateScanner your-email@example.com

# Optional secondary providers (off by default; confidence overlays only).
BINANCE_ENABLED=false
BINANCE_BASE_URL=https://api.binance.com
BINANCE_CACHE_SECONDS=5
DERIBIT_ENABLED=false
DERIBIT_BASE_URL=https://www.deribit.com/api/v2/public
DERIBIT_CACHE_SECONDS=30
FRED_ENABLED=false
FRED_CSV_URL=https://fred.stlouisfed.org/graph/fredgraph.csv
FRED_CACHE_SECONDS=3600
DEFILLAMA_ENABLED=false
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_STABLECOINS_URL=https://stablecoins.llama.fi/stablecoins?includePrices=true
DEFILLAMA_CACHE_SECONDS=900
SEC_ENHANCED_ENABLED=false
INTERNAL_BREADTH_ENABLED=false

# Strategy variant and shadow comparison (research only).
SCANNER_STRATEGY_VARIANT=layered-v4
SCANNER_SHADOW_ENABLED=false
SCANNER_SHADOW_VARIANT=legacy

# Paper-loop automation (disabled by default; dry-run only).
PAPER_LOOP_ENABLED=false
PAPER_LOOP_PHASE=disabled
PAPER_LOOP_KILL_SWITCH=false
PAPER_LOOP_SYMBOL_ALLOWLIST=
PAPER_LOOP_TARGET_NOTIONAL_USD=100
PAPER_LOOP_MAX_ACTIONS_PER_CYCLE=2
PAPER_LOOP_MAX_REQUESTS_PER_HOUR=6
PAPER_LOOP_MAX_REQUESTS_PER_DAY=20
PAPER_LOOP_MAX_REQUESTS_PER_SYMBOL_WINDOW=1
PAPER_LOOP_SYMBOL_WINDOW_SECONDS=21600
PAPER_LOOP_SYMBOL_COOLDOWN_MINUTES=360
PAPER_LOOP_SIGNAL_STALE_AFTER_MINUTES=10
PAPER_LOOP_BREAKER_FAILURES_TO_OPEN=3
PAPER_LOOP_BREAKER_OPEN_MINUTES=30

TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SCORE_THRESHOLD=65
# Absolute price/RS move (percent) required before news providers are queried.
NEWS_TRIGGER_ABS_MOVE_PCT=1.25
NEWS_CACHE_MINUTES=45

REPLAY_DEFAULT_INTERVAL_MINUTES=60
REPLAY_DEFAULT_WARMUP_BARS=30
